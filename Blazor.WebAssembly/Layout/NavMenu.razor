@using Microsoft.AspNetCore.Components.Authorization

<div class="header-caja">
    <NavLink href="/" Match="NavLinkMatch.All">
        <img class="logo-header" src="/images/logo.png" alt="Logo" />
    </NavLink>

    <nav class="nav-barra">
        <ul class="nav-links">
            <li class="nav-item-dropdown">
                <NavLink href="complejos" class="nav-link" Match="NavLinkMatch.Prefix">
                    Complejos
                </NavLink>
            </li>
            <li>
                <NavLink href="software" class="nav-link" Match="NavLinkMatch.Prefix">
                    Software
                </NavLink>
            </li>

            <!-- Evalúa automáticamente la autenticación mediante el CustomAuthStateProvider -->
            <AuthorizeView>
                <Authorizing>
                    <li>
                        <span class="nav-link">Cargando...</span>
                    </li>
                </Authorizing>
                <Authorized>
                    <li>
                        <NavLink href="perfil" class="nav-link" Match="NavLinkMatch.Prefix">
                            Mi Perfil
                        </NavLink>
                    </li>
                </Authorized>
                <NotAuthorized>
                    <li>
                        <NavLink href="login" class="nav-link" Match="NavLinkMatch.Prefix">
                            Iniciar Sesión
                        </NavLink>
                    </li>
                </NotAuthorized>
            </AuthorizeView>
        </ul>
    </nav>
</div>