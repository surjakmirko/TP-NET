@inject NavigationManager NavigationManager
@inject HttpClient Http

<div class="barraBusqueda-contenedor">
    <form class="barraBusqueda-form" @onsubmit="HandleSubmit">

        <div class="filtro-form">
            <svg class="icon" viewBox="0 0 24 24" width="24" height="24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" /></svg>
            <input name="ciudad" type="text" placeholder="Buscar Ciudad" @bind="Ciudad" required />
        </div>

        <div class="filtro-form">
            <svg class="icon" viewBox="0 0 24 24" width="24" height="24"><circle cx="12" cy="12" r="10" /><path d="M12 2v20M2 12h20" /><path d="M6.2 6.2c3.2 3.2 3.2 8.4 0 11.6" /><path d="M17.8 6.2c-3.2 3.2-3.2 8.4 0 11.6" /></svg>
            <select name="deporte" class="filtro-select" @bind="Deporte" required>
                <option value="" disabled hidden selected="@string.IsNullOrEmpty(Deporte)">
                    Seleccionar un Deporte
                </option>
                @foreach (var dep in deportes)
                {
                    <option value="@dep.Id">@dep.NombreDeporte</option>
                }
            </select>
        </div>

        <div class="filtro-form">
            <svg class="icon" viewBox="0 0 24 24" width="24" height="24"><path d="M19 4H5C3.89543 4 3 4.89543 3 6V20C3 21.1046 3.89543 22 5 22H19C20.1046 22 21 21.1046 21 20V6C21 4.89543 20.1046 4 19 4Z" /><path d="M16 2V6" /><path d="M8 2V6" /><path d="M3 10H21" /></svg>
            <input name="fecha" type="string" style="color: gray;" @bind="Fecha" required />
        </div>

        <div class="filtro-form">
            <svg class="icon" viewBox="0 0 24 24" width="24" height="24"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 12" /></svg>
            <select name="hora" required class="filtro-select" @bind="Hora">
                <option value="" disabled hidden selected="@string.IsNullOrEmpty(Hora)" style="color: gray;">Seleccionar un Horario</option>
                <option value="09:00">09:00</option>
                <option value="09:30">09:30</option>
                <option value="10:00">10:00</option>
                <option value="10:30">10:30</option>
                <option value="11:00">11:00</option>
                <option value="11:30">11:30</option>
                <option value="12:00">12:00</option>
                <option value="12:30">12:30</option>
                <option value="13:00">13:00</option>
                <option value="13:30">13:30</option>
                <option value="14:00">14:00</option>
                <option value="14:30">14:30</option>
                <option value="15:00">15:00</option>
                <option value="15:30">15:30</option>
                <option value="16:00">16:00</option>
                <option value="16:30">16:30</option>
                <option value="17:00">17:00</option>
                <option value="17:30">17:30</option>
                <option value="18:00">18:00</option>
                <option value="18:30">18:30</option>
                <option value="19:00">19:00</option>
                <option value="19:30">19:30</option>
                <option value="20:00">20:00</option>
                <option value="20:30">20:30</option>
                <option value="21:00">21:00</option>
                <option value="21:30">21:30</option>
                <option value="22:00">22:00</option>
                <option value="22:30">22:30</option>
                <option value="23:00">23:00</option>
                <option value="23:30">23:30</option>
                <option value="00:00">00:00</option>
            </select>
        </div>

        <div class="filtro-form">
            <button class="boton" type="submit">Buscar</button>
        </div>
    </form>
</div>

@code {
    // Estas propiedades se autocompletan si la URL ya trae estos parámetros
    // (equivalente a tu searchParams.get('...'))
    [SupplyParameterFromQuery(Name = "ciudad")]
    public string? Ciudad { get; set; }

    [SupplyParameterFromQuery(Name = "deporte")]
    public string? Deporte { get; set; }

    [SupplyParameterFromQuery(Name = "fecha")]
    public string? Fecha { get; set; }

    [SupplyParameterFromQuery(Name = "hora")]
    public string? Hora { get; set; }

    // Lista para poblar el select de deportes
    private List<TipoCanchaDto> deportes = new();

    // Reemplaza al useEffect() de carga inicial
    protected override async Task OnInitializedAsync()
    {
        try
        {
            // NOTA: Lo ideal en Blazor es inyectar un Servicio en vez de usar HttpClient directo,
            // pero mantenemos la lógica de tu fetch original.
            deportes = await Http.GetFromJsonAsync<List<TipoCanchaDto>>("http://localhost:3000/api/tipoCancha") ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar los deportes: {ex.Message}");
        }
    }

    // Reemplaza al handleSubmit(e) de React
    private void HandleSubmit()
    {
        // Construye un diccionario con los parámetros que no estén nulos/vacíos
        var parametros = new Dictionary<string, object?>();

        if (!string.IsNullOrWhiteSpace(Ciudad)) parametros.Add("ciudad", Ciudad);
        if (!string.IsNullOrWhiteSpace(Deporte)) parametros.Add("deporte", Deporte);
        if (!string.IsNullOrWhiteSpace(Fecha)) parametros.Add("fecha", Fecha);
        if (!string.IsNullOrWhiteSpace(Hora)) parametros.Add("hora", Hora);

        // Genera la URL (/complejos?ciudad=X&deporte=Y) y navega
        var uri = NavigationManager.GetUriWithQueryParameters("/complejos", parametros);
        NavigationManager.NavigateTo(uri);
    }

    // Clase DTO temporal para mapear el JSON (cámbiala si ya tienes tu clase en Modelo.Dominio)
    public class TipoCanchaDto
    {
        public string Id { get; set; } = string.Empty;
        // Ajusta esta propiedad según cómo te devuelve el JSON tu API (en React leías dep.deporte)
        public string NombreDeporte { get; set; } = string.Empty;
    }
}