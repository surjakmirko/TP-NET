@page "/complejos"
@using DTOs
@using API
@inject API.ComplejoApiClient Api

<h3>Listado de Complejos</h3>

@if (complejos == null)
{
    <p><em>Cargando...</em></p>
}
else if (!complejos.Any())
{
    <p>No hay complejos registrados.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Dirección</th>
                <th>Localidad</th>
                <th>Dueño</th>
                <th>Encargado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in complejos)
            {
                <tr>
                    <td>@c.Id</td>
                    <td>@c.Nombre</td>
                    <td>@c.Direccion</td>
                    <td>@c.NombreLocalidad</td>
                    <td>@c.NombreDueño</td>
                    <td>@c.NombreEncargado</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<ComplejoDTO>? complejos;

    protected override async Task OnInitializedAsync()
    {
        complejos = await API.ComplejoApiClient.ObtenerTodosAsync();
    }
}