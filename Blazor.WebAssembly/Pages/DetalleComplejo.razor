@page "/detalle-complejo/{Id:int}"
@using DTOs
@using API
@inject NavigationManager Navigation

@if (cargando)
{
    <p class="detalle-complejo-estado">Cargando complejo...</p>
}
else if (!string.IsNullOrEmpty(error))
{
    <p class="detalle-complejo-estado">@error</p>
}
else if (complejo != null)
{
    <main class="detalle-complejo">
        <!-- Imagen del complejo -->
        <img class="detalle-complejo-imagen"
             alt="Imagen de @complejo.Nombre" />

        <!-- Nombre -->
        <h1 class="detalle-complejo-nombre">@complejo.Nombre</h1>

        <!-- Invocación de la grilla de Horarios por Cancha -->
        <HorariosCancha Complejo="complejo" FechaActual="@fechaActual" />

        <!-- Acordeón de Ubicación -->
        <details class="detalle-complejo-acordeon" open>
            <summary>Ubicación</summary>
            <div class="contenido-acordeon">
                <p>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" style="margin-right: 8px; vertical-align: text-bottom;">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                        <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                    @complejo.Direccion
                    @(string.IsNullOrEmpty(complejo.NombreLocalidad) ? "" : $", {complejo.NombreLocalidad}")
                </p>
            </div>
        </details>

        <!-- Acordeón de Horarios del Club -->
        <details class="detalle-complejo-acordeon" open>
            <summary>Horarios del Club</summary>
            <div class="contenido-acordeon">
                @if (horarios != null && horarios.Any())
                {
                    @foreach (var horario in horarios)
                    {
                        <div class="horario-fila" @key="@($"{horario.ComplejoId}-{horario.NroDia}")">
                            <strong>@ObtenerNombreDia(horario.NroDia)</strong>
                            <span>@horario.HoraApertura.ToString("HH:mm") a @horario.HoraCierre.ToString("HH:mm")</span>
                        </div>
                    }
                }
                else
                {
                    <p style="color: #64748b;">No hay horarios registrados para este club.</p>
                }
            </div>
        </details>
    </main>
}

@code {
    [Parameter] public int Id { get; set; }
    [SupplyParameterFromQuery] public string? Fecha { get; set; }

    private ComplejoDTO? complejo;
    private List<HorarioDTO>? horarios;
    private bool cargando = true;
    private string error = "";
    private string fechaActual = "";

    protected override async Task OnInitializedAsync()
    {
        fechaActual = string.IsNullOrEmpty(Fecha) ? DateTime.Now.ToString("yyyy-MM-dd") : Fecha;

        if (Id <= 0)
        {
            error = "No se recibió el id del complejo.";
            cargando = false;
            return;
        }

        try
        {
            // 1. Cargar datos del complejo
            complejo = await ComplejoApiClient.ObtenerPorIdAsync(Id);

            // 2. Cargar los horarios por id
            horarios = await ComplejoApiClient.ObtenerHorariosAsync(Id);

            // 3. Cargar las canchas del complejo
            var canchas = await ComplejoApiClient.ObtenerCanchasAsync(Id);

            if (complejo != null)
            {
                // Vinculamos horarios y canchas para que HorariosCancha pueda armar la grilla
                complejo.Horarios = horarios ?? new List<HorarioDTO>();
                complejo.Canchas = canchas ?? new List<CanchaDTO>();
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private string ObtenerNombreDia(int nroDia)
    {
        return nroDia switch
        {
            1 => "Lunes",
            2 => "Martes",
            3 => "Miercoles",
            4 => "Jueves",
            5 => "Viernes",
            6 => "Sabado",
            7 or 0 => "Domingo",
            8 => "Feriado",
            _ => $"Día {nroDia}"
        };
    }
}
