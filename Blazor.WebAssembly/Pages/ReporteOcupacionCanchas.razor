@page "/reporte-ocupacion/{ComplejoId:int}"
@attribute [Authorize(Roles = "Dueño")]
@using API
@using DTOs
@using Microsoft.AspNetCore.Authorization
@inject ComplejoApiClient ComplejoApi
@inject IJSRuntime JS
@inject NavigationManager Navigation

<main class="reporte-page">
    <div class="reporte-card">
        <div class="reporte-header">
            <div class="reporte-titulo-box">
                <h2>Ocupación de canchas en el mes (Gráfico de Torta)</h2>
            </div>
            <button class="btn-volver" @onclick='() => Navigation.NavigateTo($"/complejo/{ComplejoId}")'>Volver al complejo</button>
        </div>

        @if (cargando)
        {
            <div class="reporte-estado">Cargando datos del mes...</div>
        }
        else if (rankingCanchas.Count == 0)
        {
            <div class="reporte-estado">No hay turnos registrados en este mes para generar el reporte.</div>
        }
        else
        {
            <div class="reporte-grafico">
                <!-- Contenedor para el gráfico de torta (canvas de Chart.js) -->
                <div style="width: 50%; margin: 0 auto; position: relative;">
                    <canvas id="chartOcupacionCanchas"></canvas>
                </div>

                <div class="reporte-tabla-container" style="margin-top: 20px;">
                    <table class="reporte-tabla">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Cancha</th>
                                <th class="text-center">Cantidad de reservas en el mes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < rankingCanchas.Count; i++)
                            {
                                <tr @key="i">
                                    <td class="col-pos">@((i + 1))</td>
                                    <td class="col-localidad">@rankingCanchas[i].NombreCancha</td>
                                    <td class="col-cantidad text-center">@rankingCanchas[i].TotalReservas</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</main>

@code {
    [Parameter] public int ComplejoId { get; set; }

    private List<CanchaOcupacionDTO> rankingCanchas = new();
    private bool cargando = true;
    private bool graficoRenderizado = false; // Bandera para controlar el dibujo

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var complejo = await ComplejoApiClient.ObtenerPorIdAsync(ComplejoId);

            if (complejo?.Canchas != null)
            {
                var mesActual = DateTime.Now.Month;
                var anioActual = DateTime.Now.Year;

                rankingCanchas = complejo.Canchas
                    .Select(cancha =>
                    {
                        // PRUEBA DE FUEGO: Imprimimos en consola qué tiene el frontend en la mano
                        if (cancha.Turnos != null && cancha.Turnos.Any())
                        {
                            foreach (var t in cancha.Turnos)
                            {
                                Console.WriteLine($"Turno en Cancha #{cancha.Nro} -> Fecha: {t.Fecha}, Estado: '{t.Estado}'");
                            }
                        }
                        else
                        {
                            Console.WriteLine($"Cancha #{cancha.Nro} tiene la lista de Turnos vacía o null en este componente.");
                        }

                        // Le quitamos el filtro de mes y año temporalmente para ver si es culpa de la fecha
                        int reservasTotales = cancha.Turnos?
                            .Count(t => t.Estado?.Trim().ToLower() != "cancelado") ?? 0;

                        return new CanchaOcupacionDTO
                        {
                            NombreCancha = !string.IsNullOrEmpty(cancha.Deporte)
                                ? $"{cancha.Deporte} (Cancha #{cancha.Nro})"
                                : $"Cancha #{cancha.Nro}",

                            TotalReservas = reservasTotales // <-- Ahora cuenta TODOS, sin importar el mes
                        };
                    })
                    .OrderByDescending(x => x.TotalReservas)
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar reporte de ocupación: {ex.Message}");
        }
        finally
        {
            cargando = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // En lugar de firstRender, verificamos que ya no esté cargando y que no lo hayamos dibujado antes
        if (!cargando && rankingCanchas.Count > 0 && !graficoRenderizado)
        {
            graficoRenderizado = true; // Evita que se vuelva a ejecutar en futuros renders

            await Task.Delay(200);

            var labels = rankingCanchas.Select(r => r.NombreCancha).ToArray();
            var valores = rankingCanchas.Select(r => (decimal)r.TotalReservas).ToArray();

            // Si la suma de todas las reservas es 0, Chart.js fallará.
            // Esto es opcional, pero previene errores en consola si no hay actividad en el mes.
            if (valores.Sum() == 0)
            {
                Console.WriteLine("No hay reservas este mes para graficar.");
                return;
            }

            try
            {
                await JS.InvokeVoidAsync("renderPieChart", "chartOcupacionCanchas", labels, valores, "Ocupación de Canchas");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error al renderizar gráfico JS: {ex.Message}");
            }
        }
    }

    public class CanchaOcupacionDTO
    {
        public string NombreCancha { get; set; } = string.Empty;
        public int TotalReservas { get; set; }
    }
}