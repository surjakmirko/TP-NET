@page "/confirmar-reserva"
@using API
@using API.Client
@using DTOs
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject TurnoApiClient ReservaService
@inject IAutenticacionService AuthService

<div class="confirmar-reserva-wrapper">
    <div class="reserva-container">

        <!-- Encabezado Principal -->
        <header class="reserva-header">
            <h1>@(EsModoEncargado ? "Agendar Reserva" : "¡Ya casi terminamos!")</h1>
            <p>@(EsModoEncargado ? "Ingresá los datos del cliente para agendar la reserva manualmente." : "Revisá los detalles de tu turno y tus datos para confirmar la reserva.")</p>
        </header>

        <EditForm Model="titular" OnValidSubmit="HandleConfirmar">
            <DataAnnotationsValidator />

            <!-- Sección de Tarjetas Separadas -->
            <div class="reserva-grid">

                <!-- Tarjeta 1: Detalles del Turno -->
                <div class="card-reserva card-turno">
                    <h2>Detalles del Turno</h2>

                    <div class="info-grupo con-linea">
                        <span class="info-label">Complejo</span>
                        <div class="info-detalle">
                            <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5m0 0h4m-4 0V11m0 0h4m-4 0H9m4 0V5" />
                            </svg>
                            <span class="info-valor destacado">
                                @(cargando ? "Cargando..." : reserva?.ComplejoNombre ?? "Cargando...")
                            </span>
                        </div>
                    </div>

                    <div class="info-grupo con-linea">
                        <span class="info-label">Ubicación</span>
                        <div class="info-detalle">
                            <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                            <span class="info-valor">
                                @(cargando ? "Cargando..." : reserva?.ComplejoUbicacion ?? "Cargando...")
                            </span>
                        </div>
                    </div>

                    <div class="info-grupo con-linea">
                        <span class="info-label">Cancha</span>
                        <div class="info-detalle">
                            <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
                            </svg>
                            <span class="info-valor">Cancha @(CanchaNro.HasValue? CanchaNro.Value.ToString() : "1")</span>
                        </div>
                    </div>

                    <div class="info-grupo con-linea">
                        <span class="info-label">Deporte</span>
                        <div class="info-detalle">
                            <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            <span class="info-valor">
                                @(cargando ? "Cargando..." : reserva?.Deporte ?? "General")
                            </span>
                        </div>
                    </div>

                    <div class="info-row con-linea">
                        <div class="info-grupo">
                            <span class="info-label">Hora Inicio</span>
                            <div class="info-detalle">
                                <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                <span class="info-valor">@(horarioInicioTime.HasValue? horarioInicioTime.Value.ToString("HH:mm") : "18:04") hs</span>
                            </div>
                        </div>

                        <div class="info-grupo">
                            <span class="info-label">Hora Fin</span>
                            <div class="info-detalle">
                                <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                <span class="info-valor">@(string.IsNullOrEmpty(horaFin) ? "19:04" : horaFin) hs</span>
                            </div>
                        </div>
                    </div>

                    <div class="info-grupo precio-row con-linea">
                        <span class="info-label">Precio Seña</span>
                        <div class="info-detalle">
                            <svg class="icon icon-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" />
                            </svg>
                            <span class="info-valor sena">
                                $ @(cargando ? "..." : reserva?.PrecioSena ?? "10.000")
                            </span>
                        </div>
                    </div>

                    <div class="info-grupo precio-row total">
                        <span class="info-label">Precio Total</span>
                        <div class="info-detalle">
                            <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                            </svg>
                            <span class="info-valor total-monto">
                                $ @(cargando ? "..." : reserva?.PrecioTotal ?? "37.000")
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Tarjeta 2: Datos del Cliente (HABILITADOS EN MODO ENCARGADO) -->
                <div class="card-reserva card-titular">
                    <h2>@(EsModoEncargado ? "Datos del Cliente" : "Datos del Titular")</h2>

                    <div class="reserva-form">
                        <div class="input-forum-group">
                            <label for="nombre">Nombre</label>
                            <InputText id="nombre" class="input-forum" @bind-Value="titular.Nombre" placeholder="Ej. Mirko" required readonly="@(EsModoEncargado ? null : "readonly")" />
                        </div>

                        <div class="input-forum-group">
                            <label for="apellido">Apellido</label>
                            <InputText id="apellido" class="input-forum" @bind-Value="titular.Apellido" placeholder="Ej. Surjak" required readonly="@(EsModoEncargado ? null : "readonly")" />
                        </div>

                        <div class="input-forum-group">
                            <label for="dni">DNI</label>
                            <InputText id="dni" class="input-forum" @bind-Value="titular.Dni" placeholder="Ej. 1243123" required readonly="@(EsModoEncargado ? null : "readonly")" />
                        </div>

                        <div class="input-forum-group">
                            <label for="telefono">Teléfono</label>
                            <InputText id="telefono" type="tel" class="input-forum" @bind-Value="usuario.Telefono" placeholder="Ej. +54 3471 330992" required readonly="@(EsModoEncargado ? null : "readonly")" />
                        </div>

                        <div class="input-forum-group">
                            <label for="email">Correo Electrónico</label>
                            <InputText id="email" type="email" class="input-forum" @bind-Value="usuario.Email" placeholder="tuemail@ejemplo.com" required readonly="@(EsModoEncargado ? null : "readonly")" />
                        </div>
                    </div>
                </div>

            </div>

            <!-- Botón de Confirmar centrado ABAJO -->
            <div class="confirmar-action">
                <button type="submit" class="btn-confirmar" disabled="@cargando">
                    @(cargando ? "Procesando..." : (EsModoEncargado ? "Agendar Turno" : "Confirmar Reserva"))
                </button>
            </div>
        </EditForm>
    </div>

    <!-- Modal de Confirmación -->
    @if (mostrarModal)
    {
        <div class="modal-overlay">
            <div class="modal-confirmacion-contenido">
                <h2>¡Reserva Confirmada!</h2>
                <p>El turno se ha registrado correctamente en la agenda.</p>
                <p class="modal-subtexto">
                    @(EsModoEncargado ? "Podés consultar y gestionar los turnos desde el Panel del Encargado." : "Recuerde que puede ver sus turnos en su perfil.")
                </p>

                <button type="button" class="btn-modal-home" @onclick="IrAlDestino">
                    @(EsModoEncargado ? "Volver a la Agenda" : "Ir al Home")
                </button>
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "complejoId")]
    public int? ComplejoId { get; set; }

    [SupplyParameterFromQuery(Name = "canchaNro")]
    public int? CanchaNro { get; set; }

    [SupplyParameterFromQuery(Name = "fecha")]
    public string? FechaRaw { get; set; }

    [SupplyParameterFromQuery(Name = "horarioInicio")]
    public string? HorarioInicioRaw { get; set; }

    [SupplyParameterFromQuery(Name = "modo")]
    public string? Modo { get; set; }

    private bool EsModoEncargado => string.Equals(Modo, "encargado", StringComparison.OrdinalIgnoreCase);

    private DateOnly? fechaDate;
    private TimeOnly? horarioInicioTime;

    private PersonaFisicaDTO titular = new();
    private UsuarioDTO usuario = new();
    private ReservaDetalleDTO? reserva;
    private string horaFin = string.Empty;
    private bool cargando = false;
    private bool mostrarModal = false;
    private int clienteId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            // Si NO entra en modo encargado, traemos los datos del perfil del usuario logueado
            if (!EsModoEncargado)
            {
                usuario.Email = user.FindFirst(ClaimTypes.Email)?.Value ?? string.Empty;
                usuario.Telefono = user.FindFirst(ClaimTypes.HomePhone)?.Value ?? string.Empty;

                var usuarioIdClaim = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

                if (int.TryParse(usuarioIdClaim, out var idParsed))
                {
                    clienteId = idParsed;
                    try
                    {
                        var usuarioCompleto = await UsuarioApiClient.GetByIdAsync(clienteId);
                        if (usuarioCompleto != null && usuarioCompleto.Nombre != null)
                        {
                            titular.Nombre = usuarioCompleto.Nombre;
                            titular.Apellido = usuarioCompleto.Apellido;
                            titular.Dni = usuarioCompleto.PersonaFisicaDni;
                        }
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"Error al traer datos del usuario: {ex.Message}");
                    }
                }
            }
        }
        else
        {
            Navigation.NavigateTo("/login");
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // Parsear fecha desde la URL
        if (!string.IsNullOrEmpty(FechaRaw) && DateOnly.TryParse(FechaRaw, out var fParsed))
        {
            fechaDate = fParsed;
        }

        // Parsear hora de inicio desde la URL (ej: "18:04")
        if (!string.IsNullOrEmpty(HorarioInicioRaw) && TimeOnly.TryParse(HorarioInicioRaw, out var hParsed))
        {
            horarioInicioTime = hParsed;
            horaFin = horarioInicioTime.Value.AddHours(1).ToString("HH:mm");
        }

        if (ComplejoId.HasValue && CanchaNro.HasValue)
        {
            await CargarDetallesReservaAsync(ComplejoId.Value, CanchaNro.Value);
        }
    }

    private async Task HandleConfirmar()
    {
        if (!ComplejoId.HasValue || !CanchaNro.HasValue || !fechaDate.HasValue || !horarioInicioTime.HasValue)
        {
            Console.WriteLine("Error: Faltan parámetros requeridos en la URL.");
            return;
        }

        cargando = true;
        try
        {
            int clienteIdParaTurno = clienteId;
            if (EsModoEncargado)
            {
                UsuarioCrearDTO nuevoUsuario = new UsuarioCrearDTO
                    {
                        Email = usuario.Email,
                        Telefono = usuario.Telefono,
                        PersonaFisicaDni = titular.Dni,
                        PersonaJuridicaCuit = null,
                        TipoUsuarioId = 3,
                        Password = "cambiar"
                    };
                PersonaFisicaDTO nuevaPersona = new PersonaFisicaDTO
                    {
                        Nombre = titular.Nombre,
                        Dni = titular.Dni,
                        Apellido = titular.Apellido
                    };
                try
                {
                    //intento crear una persona
                    await PersonaFisicaApiClient.CrearPersonaFisicaAsync(nuevaPersona);
                }
                catch (Exception ex)
                {
                    //si ya existre me da error
                    Console.WriteLine($"La persona física con DNI {titular.Dni} ya existía o falló: {ex.Message}");
                }

               
                try
                {
                    //intento crear un usuario
                    await UsuarioApiClient.CrearUsuarioAsync(nuevoUsuario);
                }
                catch (Exception ex)
                {
                    //si ya existe lanza usuario
                    Console.WriteLine($"El usuario con DNI {titular.Dni} o Email {usuario.Email} ya existía o falló: {ex.Message}");
                }
                var todosLosUsuarios = await UsuarioApiClient.GetAllAsync(); //traemos todos
                var usuarioEncontrado = todosLosUsuarios?.FirstOrDefault(u =>
                    string.Equals(u.Email, usuario.Email, StringComparison.OrdinalIgnoreCase)); //seleccionamos el del email
                if (usuarioEncontrado != null)
                {
                    clienteIdParaTurno = usuarioEncontrado.Id;
                }
                else
                {
                    Console.WriteLine("No se pudo obtener el ID del usuario para asignar el turno.");
                    return;
                }


            }

            var exito = await TurnoApiClient.CrearTurnoAsync(new TurnoCrearDTO
            {
                HoraInicio = horarioInicioTime.Value,
                HoraFin = horarioInicioTime.Value.AddHours(1),
                Estado = "Reservado",
                ClienteId = clienteIdParaTurno,
                TipoTurnoId = 1,
                ComplejoId = ComplejoId.Value,
                CanchaNro = CanchaNro.Value,
                Fecha = fechaDate.Value
            });

            if (exito != null)
            {
                mostrarModal = true;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al agendar reserva: {ex.Message}");
        }
        finally
        {
            cargando = false;
        }
    }

    private void IrAlDestino()
    {
        if (EsModoEncargado)
        {
            Navigation.NavigateTo("/menu-encargado");
        }
        else
        {
            Navigation.NavigateTo("/");
        }
    }

    private async Task CargarDetallesReservaAsync(int complejoId, int canchaNro)
    {
        cargando = true;
        try
        {
            var complejo = await ComplejoApiClient.ObtenerPorIdAsync(complejoId);
            var cancha = await ComplejoApiClient.ObtenerCanchaPorNroAsync(complejoId, canchaNro);

            if (complejo != null)
            {
                reserva = new ReservaDetalleDTO
                {
                    ComplejoNombre = complejo.Nombre,
                    ComplejoUbicacion = $"{complejo.Direccion}, {complejo?.NombreLocalidad ?? ""}",
                    Deporte = cancha?.Deporte ?? "Fútbol",
                    PrecioTotal = cancha != null ? cancha.Precio.ToString("N0") : "10.000",
                };
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar datos del complejo/cancha: {ex.Message}");
        }
        finally
        {
            cargando = false;
        }
    }

    public class ReservaDetalleDTO
    {
        public string ComplejoNombre { get; set; } = string.Empty;
        public string ComplejoUbicacion { get; set; } = string.Empty;
        public string Deporte { get; set; } = string.Empty;
        public string PrecioSena { get; set; } = string.Empty;
        public string PrecioTotal { get; set; } = string.Empty;
    }
}