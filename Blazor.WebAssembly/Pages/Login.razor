@page "/login"
@using API.Client
@using DTOs
@using Blazor.WebAssembly.Servicios
@inject IAutenticacionService AuthService
@inject NavigationManager Navigation

<div class="login-container">
    <div class="login-card">
        <div class="login-form-side">
            <div class="login-header">
                <div class="brand-logo">TL</div>
                <h2>Turno Libre</h2>
                <p class="login-subtitle">Ingresá tus datos para acceder a tus reservas</p>
            </div>

            <EditForm Model="loginModel" OnValidSubmit="HandleSubmit" class="login-form">
                <DataAnnotationsValidator />

                <div class="form-group mb-3">
                    <label for="email">Correo Electrónico</label>
                    <InputText id="email"
                               type="email"
                               class="form-control"
                               @bind-Value="loginModel.Email"
                               placeholder="tuemail@ejemplo.com"
                               required />
                </div>

                <div class="password-group mb-3">
                    <div class="form-group">
                        <label for="password">Contraseña</label>
                        <InputText id="password"
                                   type="password"
                                   class="form-control"
                                   @bind-Value="loginModel.Password"
                                   placeholder="••••••••"
                                   required />
                    </div>
                    <div class="forgot-wrapper">
                        <a href="/forgot" class="redirect-forgot">
                            ¿Olvidaste tu contraseña?
                        </a>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger mb-3">@errorMessage</div>
                }

                <button class="login-boton" type="submit" disabled="@cargando">
                    @(cargando ? "Cargando..." : "Iniciar Sesión")
                </button>
            </EditForm>

            <div class="login-footer">
                <p>¿No tenés una cuenta? <a href="/register" class="redirect-register">Crear cuenta</a></p>
            </div>
        </div>

        <div class="login-image-side">
            <div class="image-overlay">
                <h3>Reservá tu cancha en segundos</h3>
                <p>Conectá con tus amigos y jugá en los mejores complejos deportivos.</p>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string RedirectTo { get; set; } = "/";

    private LoginDTO loginModel = new();
    private string errorMessage = string.Empty;
    private bool cargando = false;

    private async Task HandleSubmit()
    {
        cargando = true;
        errorMessage = string.Empty;

        try
        {
            // Delegamos la validación, llamada a la API y guardado en localStorage al servicio
            var success = await AuthService.LoginAsync(loginModel.Email, loginModel.Password);

            if (success)
            {
                Navigation.NavigateTo(RedirectTo);
            }
            else
            {
                errorMessage = "Correo electrónico o contraseña incorrectos";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error de conexión con el servidor: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }
}