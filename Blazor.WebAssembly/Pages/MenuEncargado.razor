@page "/menu-encargado"
@using DTOs
@using API
@inject ComplejoApiClient ComplejoService
@using System.Security.Claims
@using Blazor.WebAssembly.Servicios
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject BlazorWasmAuthService AuthService

@if (cargando)
{
    <main class="menu-encargado-estado">Cargando tu complejo...</main>
}
else if (!string.IsNullOrEmpty(error))
{
    <main class="menu-encargado-estado">@error</main>
}
else if (complejo != null)
{
    <main class="menu-encargado">
        <header class="menu-encargado-cabecera">
            <div>
                <p class="menu-encargado-etiqueta">Panel del encargado</p>
                <h1>@complejo.Nombre</h1>
                <p>@complejo.Direccion, @complejo.NombreLocalidad</p>
            </div>
            <label class="menu-encargado-fecha">
                Fecha
                <input type="text" @bind="fecha" @bind:event="oninput" readonly="true"" />
            </label>
        </header>

        <section class="menu-encargado-resumen">
            <div>
                <strong>@(complejo.Canchas?.Count ?? 0)</strong>
                <span>Canchas</span>
            </div>
            <div>
                <strong>@(CalcularReservasDelDia())</strong>
                <span>Reservas del día</span>
            </div>
            <div>
                <strong>@(EstaAbierto() ? "Abierto" : "Cerrado")</strong>
                <span>Estado del complejo</span>
            </div>
        </section>

        <section class="menu-encargado-grilla">
            <div class="menu-encargado-grilla-cabecera">
                <div>
                    <h2>Agenda de canchas</h2>
                    <p>Seleccioná un turno ocupado para consultar los datos del cliente.</p>
                </div>
                <div class="leyenda">
                    <span class="leyenda-libre"></span> Disponible 
                    <span class="leyenda-ocupada"></span> Reservada
                </div>
            </div>
            
            <!-- Llamamos al componente HorariosCancha -->
            <HorariosCancha Complejo="complejo" FechaActual="@fecha" EsPanelEncargado="true" />
        </section>
    </main>
}
else
{
    // Nueva rama: mostrar mensaje cuando no hay complejo y no hubo excepción
    <main class="menu-encargado-estado">No se encontró un complejo para el encargado.</main>
}

@code {
    private ComplejoDTO? complejo;
    private string fecha = ObtenerFechaHoy();
    private bool cargando = true;
    private string error = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // 1. Obtener el estado de autenticación
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;


            if (user.Identity != null && user.Identity.IsAuthenticated)
            {
                // Extraer el ID del usuario/encargado desde los claims (NameIdentifier)
                var idClaim = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

                if (int.TryParse(idClaim, out var idEncargado))
                {
                    // 3. Pasar el idEncargado al cliente de la API
                    complejo = await ComplejoApiClient.ObtenerComplejoDelEncargadoAsync(idEncargado);

                    if (complejo == null)
                    {
                        error = string.Empty;
                    }
                    if (complejo != null)
                    {
                        var canchasConPrecios = await CanchaApiClient.ObtenerPorComplejoIdAsync(complejo.Id);
                        if (canchasConPrecios != null)
                        {
                            complejo.Canchas = canchasConPrecios;
                        }

                        var horarios = await ComplejoApiClient.ObtenerHorariosAsync(complejo.Id);
                        if (horarios != null)
                        {
                            complejo.Horarios = horarios;
                        }
                    }
                   
                }
                else
                {
                    error = "No se pudo identificar al usuario encargado en el token.";
                }
            }
            else
            {
                // Si no está autenticado, redirigir al login
                Navigation.NavigateTo("/login");
            }
        }
        catch (Exception ex)
        {
            error = ex.ToString();
        }
        finally
        {
            cargando = false;
        }
    }

    private static string ObtenerFechaHoy()
    {
        return DateTime.Now.ToString("yyyy-MM-dd");
    }

    private int CalcularReservasDelDia()
    {
        if (complejo?.Canchas == null) return 0;

        if (!DateOnly.TryParse(fecha, out var fechaDate)) return 0;

        int total = 0;
        foreach (var cancha in complejo.Canchas)
        {
            if (cancha.Turnos == null) continue;

            total += cancha.Turnos.Count(turno =>
                turno.Fecha == fechaDate &&
                turno.Estado?.ToLower() != "cancelado"
            );
        }
        return total;
    }

    private bool EstaAbierto()
    {
        if (complejo?.Horarios == null || !complejo.Horarios.Any()) return false;

        if (!DateOnly.TryParse(fecha, out var fechaSeleccionada)) return false;

        int nroDia = ((int)fechaSeleccionada.DayOfWeek == 0) ? 7 : (int)fechaSeleccionada.DayOfWeek;
        return complejo.Horarios.Any(h => h.NroDia == nroDia);
    }
}