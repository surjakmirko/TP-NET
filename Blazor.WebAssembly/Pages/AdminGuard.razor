@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@implements IDisposable

@code {
    // Lista de todas las rutas a las que el Admin tiene permiso de entrar
    private readonly string[] RutasPermitidasAdmin = new[] {
        "menu-admin",
        "administrar-complejos",
        "administrar-usuarios",
        "crear-usuario",
        "crear-complejo",
        "reporte-localidades"
    };

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        await VerificarRuta(Navigation.Uri);
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        await VerificarRuta(e.Location);
    }

    private async Task VerificarRuta(string url)
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();

        if (authState.User.IsInRole("Administrador"))
        {
            var rutaRelativa = Navigation.ToBaseRelativePath(url).ToLower();

            // Verificamos si la URL actual empieza con alguna de las rutas permitidas
            bool rutaValida = RutasPermitidasAdmin.Any(ruta => rutaRelativa.StartsWith(ruta));

            if (!rutaValida)
            {
                // Si intenta salir de su zona, lo pateamos de vuelta al menú admin
                Navigation.NavigateTo("/menu-admin");
            }
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}