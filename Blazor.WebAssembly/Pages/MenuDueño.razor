@page "/menu-dueno"
@using DTOs
@using API
@using System.Globalization
@using System.Security.Claims
@using Blazor.WebAssembly.Servicios
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize(Roles = "Dueño")]
@using Microsoft.AspNetCore.Authorization
@inject AuthenticationStateProvider AuthStateProvider

@inject NavigationManager Navigation;
@inject BlazorWasmAuthService AuthService

<main class="contenedor-menuDueño">
    <div class="partesuperior">
        <div class="titulos">
            <h1 class="titulo-menuDueño">Buen Día Dueño</h1>
            <p>Aquí tienes la información acerca de tus complejos</p>
        </div>
        <div class="fecha"></div>
    </div>

    <div class="contenidoprincipal">
        <div class="tarjetasMetricas">
            @* Tarjeta 1: Ingresos Estimados *@
            <TarjetaMenuDueno 
                Titulo="Ingresos Estimados Hoy" 
                Valor="@FormatearMoneda(datos.IngresosEstimados)" 
                Icono="💵" 
                EsVerde="true" />
            
            @* Tarjeta 2: Reservas Hoy *@
            <TarjetaMenuDueno 
                Titulo="Reservas Hoy" 
                Valor="@datos.CantidadTurnos.ToString()" 
                Icono="📅" 
                EsVerde="false" />
            
            @* Tarjeta 3: Canchas Activas *@
            <TarjetaMenuDueno 
                Titulo="Canchas Activas" 
                Valor="@datos.CantidadCanchas.ToString()" 
                Icono="🟢" 
                EsVerde="true" />
            
            @* Tarjeta 4: Ocupación Promedio *@
            <TarjetaMenuDueno 
                Titulo="Ocupación Promedio" 
                Valor="@(datos.OcupacionPorcentaje.ToString("F1") + "%")" 
                Icono="📊" 
                EsVerde="false" />
        </div>

        <div class="listaComplejos">
            <div class="listaComplejos-header">
                <h2>Mis complejos</h2>
                <span class="sub-hint">Selecciona uno para gestionar horarios y detalles</span>
            </div>

            @if (cargandoComplejos)
            {
                <p class="cargando">Cargando tus complejos...</p>
            }
            else if (!string.IsNullOrEmpty(error))
            {
                <p class="error">@error</p>
            }
            else if (complejos.Any())
            {
                <div class="grid-complejos">
                    @foreach (var complejo in complejos)
                    {
                        <TarjetaMenuDuenoComplejo 
                            ComplejoId="@complejo.Id"
                            Nombre="@complejo.Nombre"
                            Direccion="@complejo.Direccion"
                            NombreLocalidad="@complejo.NombreLocalidad"
                            CantidadCanchas="@complejo.CantidadCanchas"
                            Deportes="complejo.Deportes"
                            CanchasDisponibles="@complejo.CantidadCanchas" />
                    }
                </div>
            }
            else
            {
                <p class="sin-complejos">No tenés complejos registrados aún.</p>
            }
        </div>
    </div>
</main>

@code {
    private List<ComplejoTarjetaDTO> complejos = new();
    private DashboardDuenoDTO datos = new();
    private bool cargando = true;
    private bool cargandoComplejos = true;
    private string error = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // 1. Obtener el estado de autenticación del usuario actual
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity != null && user.Identity.IsAuthenticated)
            {
                // 2. Extraer el ID del dueño desde los claims (NameIdentifier)
                var idClaim = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

                if (int.TryParse(idClaim, out var idDueno))
                {
                    // 3. Cargar los complejos del dueño y las métricas del dashboard en paralelo
                    var taskComplejos = ComplejoApiClient.ObtenerPorDuenoAsync(idDueno);
                    var taskDatos = DashboardApiClient.ObtenerMetricasDuenoAsync(idDueno);

                    await Task.WhenAll(taskComplejos, taskDatos);

                    complejos = await taskComplejos ?? new List<ComplejoTarjetaDTO>();
                    datos = await taskDatos ?? new DashboardDuenoDTO();
                }
                else
                {
                    error = "No se pudo identificar al usuario dueño en el token.";
                }
            }
            else
            {
                // Si no está autenticado, redirigir al login
                Navigation.NavigateTo("/login");
            }
        }
        catch (Exception ex)
        {
            error = $"Ocurrió un error al cargar los datos: {ex.Message}";
        }
        finally
        {
            cargando = false;
            cargandoComplejos = false;
        }
    }

    private string FormatearMoneda(decimal valor)
    {
        return valor.ToString("C", new CultureInfo("es-AR"));
    }
}